# String de conexão do MongoDB Atlas (Driver > Node.js)
# Ex.: mongodb+srv://usuario:senha@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
DATABASE_URL=

# Nome do database (padrão: PetCuidado)
DATABASE_NAME=PetCuidado

# Chave usada para assinar o JWT. Gere uma com: openssl rand -hex 32
SECRET=

PORT=3001
